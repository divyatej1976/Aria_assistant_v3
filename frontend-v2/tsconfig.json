{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-playwright/types/**/*.ts",
    ".next-playwright/dev/types/**/*.ts",
    ".next-verification/types/**/*.ts",
    ".next-verification/dev/types/**/*.ts",
    ".next-compose/types/**/*.ts",
    ".next-compose/dev/types/**/*.ts",
    ".next-fulltest/types/**/*.ts",
    ".next-fulltest/dev/types/**/*.ts",
    ".next-polish-current/types/**/*.ts",
    ".next-polish-current/dev/types/**/*.ts",
    ".next-polish-build-host/types/**/*.ts",
    ".next-polish-build-host/dev/types/**/*.ts",
    ".next-polish-webpack/types/**/*.ts",
    ".next-polish-webpack/dev/types/**/*.ts",
    ".next-review-verification/types/**/*.ts",
    ".next-review-verification/dev/types/**/*.ts",
    ".next-review-consistency/types/**/*.ts",
    ".next-review-consistency/dev/types/**/*.ts",
    ".next-review-consistency-build/types/**/*.ts",
    ".next-review-consistency-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
