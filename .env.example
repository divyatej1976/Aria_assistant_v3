# Application
ARIA_ENV=development
ARIA_LOG_LEVEL=INFO
ARIA_CORS_ORIGINS=http://localhost:3000
# Base URL used to build absolute links in emails (password reset / verify).
ARIA_PUBLIC_URL=http://localhost:3000

# Backend
DATABASE_URL=postgresql+psycopg://aria:aria@localhost:5432/aria

# Supabase-compatible auth boundary
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Session signing secret. Required when ARIA_ENV=production.
ARIA_SESSION_SECRET=

# Security hardening (production)
# Enforced only when ARIA_ENV=production.
ARIA_TRUSTED_HOSTS=localhost,127.0.0.1
ARIA_RATE_LIMIT_ENABLED=true
ARIA_RATE_LIMIT_REQUESTS=10
ARIA_RATE_LIMIT_WINDOW_SECONDS=60
# Rate-limit backend: memory (single replica) or db (shared fixed-window table,
# safe for multiple replicas; production compose defaults to db).
ARIA_RATE_LIMIT_BACKEND=memory

# Background scheduler. Set false to run reminders only via the pull endpoint.
ARIA_SCHEDULER_ENABLED=true
ARIA_REMINDER_CHECK_INTERVAL_MINUTES=60
ARIA_AUDIO_QUEUE_INTERVAL_SECONDS=30
# Standalone sweeper for expired idempotency keys (advisory-locked job).
ARIA_IDEMPOTENCY_SWEEP_INTERVAL_SECONDS=600

# Web push (VAPID). Leave empty to log push delivery instead of sending.
# Generate keys with: python scripts/generate_vapid.py
ARIA_VAPID_PUBLIC_KEY=
ARIA_VAPID_PRIVATE_KEY=
ARIA_VAPID_SUBJECT=mailto:noreply@aria.local

# Observability. Metrics are always exposed at /api/v1/../metrics; these are optional.
# Sentry: error tracking. Leave empty to disable.
ARIA_SENTRY_DSN=
# Langfuse: AI trace export. Leave empty to disable.
ARIA_LANGFUSE_PUBLIC_KEY=
ARIA_LANGFUSE_SECRET_KEY=
ARIA_LANGFUSE_HOST=

# AI provider boundary (do not commit real keys)
# Production: inject GROQ_API_KEY from the deployment secret manager,
# never from a committed .env file.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# BYO learner keys (Step 4): dedicated Fernet encryption key, independent of
# ARIA_SESSION_SECRET so session-secret rotation never invalidates stored keys.
# Generate with: python scripts/generate_llm_keys_key.py
# Rotation: move the current primary to ARIA_LLM_KEYS_ENCRYPTION_KEY_OLD,
# deploy, re-encrypt (re-save), then drop _OLD.
ARIA_LLM_KEYS_ENCRYPTION_KEY=
ARIA_LLM_KEYS_ENCRYPTION_KEY_OLD=
ARIA_LLM_ALLOWED_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Per-learner monthly cap in USD (0 = unlimited). Global cap stays separate.
ARIA_LLM_PER_USER_BUDGET_USD=0
# Completion-token floor reserved per call when a per-user budget is active.
ARIA_LLM_COMPLETION_RESERVE_TOKENS=512
# Scheduled database backups (pg_dump; PostgreSQL only; scheduler job runs
# under the usual advisory lock). Restore: python scripts/restore_db.py
ARIA_BACKUP_ENABLED=false
ARIA_BACKUP_DIR=backups
ARIA_BACKUP_INTERVAL_HOURS=24
ARIA_BACKUP_KEEP=14
# Production reverse proxy domain for TLS (Caddy; used by docker-compose.prod).
ARIA_DOMAIN=
# Embeddings: leave ARIA_EMBEDDING_API_KEY empty to use the deterministic
# local embedder. Dimension must match the pgvector column (migration 0011).
ARIA_EMBEDDING_API_KEY=
ARIA_EMBEDDING_MODEL=text-embedding-3-small
ARIA_EMBEDDING_BASE_URL=
ARIA_EMBEDDING_DIM=768
# Monthly AI spend cap in USD. 0 = unlimited. When reached, generation falls
# back to deterministic behavior until the process restarts (in-memory budget).
ARIA_AI_MONTHLY_BUDGET_USD=0
# How long Idempotency-Key responses are replayed (seconds).
ARIA_IDEMPOTENCY_TTL_SECONDS=3600

# Email reminders (SMTP). Leave SMTP_HOST empty to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ARIA <noreply@aria.local>
SMTP_USE_TLS=true

# Audio: text-to-speech + speech-to-text. ARIA_TTS_PROVIDER=auto uses a
# provider chain — Groq TTS/STT when GROQ_API_KEY is set (no separate key),
# then the OpenAI-compatible cloud keys below, then the local pyttsx3/espeak
# fallback. The Groq orpheus TTS model needs one-time terms acceptance by the
# Groq org admin in the console before the API allows calls.
ARIA_TTS_PROVIDER=auto
ARIA_TTS_API_KEY=
ARIA_STT_API_KEY=
ARIA_TTS_MODEL=canopylabs/orpheus-v1-english
ARIA_TTS_VOICE=tara
ARIA_STT_MODEL=whisper-large-v3

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public VAPID key for the browser push client (must match ARIA_VAPID_PUBLIC_KEY).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

