# Application
ARIA_ENV=development
ARIA_LOG_LEVEL=INFO
ARIA_API_PREFIX=/api/v1
ARIA_CORS_ORIGINS=http://localhost:3000

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://aria:aria@localhost:5432/aria

# Supabase-compatible auth boundary
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Session signing secret. Required when ARIA_ENV=production.
ARIA_SESSION_SECRET=

# Security hardening (production)
# Enforced only when ARIA_ENV=production.
ARIA_TRUSTED_HOSTS=localhost,127.0.0.1
ARIA_RATE_LIMIT_ENABLED=true
ARIA_RATE_LIMIT_REQUESTS=10
ARIA_RATE_LIMIT_WINDOW_SECONDS=60

# Background scheduler. Set false to run reminders only via the pull endpoint.
ARIA_SCHEDULER_ENABLED=true
ARIA_REMINDER_CHECK_INTERVAL_MINUTES=60
ARIA_AUDIO_QUEUE_INTERVAL_SECONDS=30

# AI provider boundary (do not commit real keys)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Email reminders (SMTP). Leave SMTP_HOST empty to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ARIA <noreply@aria.local>
SMTP_USE_TLS=true

# Audio: text-to-speech + speech-to-text. ARIA_TTS_PROVIDER=auto uses cloud when
# a key is set, otherwise the local pyttsx3 fallback.
ARIA_TTS_PROVIDER=auto
ARIA_TTS_API_KEY=
ARIA_STT_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

